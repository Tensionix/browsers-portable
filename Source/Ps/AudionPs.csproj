<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The PowerShell 7 of Audion Browsers Portable: the console host of Microsoft.PowerShell.SDK
    under the program's own name. The scripts of the builder and of the cleanup
    (install\*.ps1) run with this file, so no PowerShell is downloaded when the project is
    built and none of the machine is counted on. It is published into App\ beside the window
    and shares the runtime with it. The pattern is Source\Ps of Audion Sync Tools.

    One thing stays with the PowerShell of Windows on purpose: the guard that asks for an
    exclusion of Windows Defender (system_core\services\defender_guard.ps1). It is raised
    through UAC, and the question of Windows should name a file signed by Microsoft, not an
    unsigned one of ours; and the module of Defender belongs to that PowerShell.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>AudionPs</AssemblyName>
    <RootNamespace>AudionBrowsersPortable.Ps</RootNamespace>
    <Product>Audion Browsers Portable</Product>
    <AssemblyTitle>Audion Browsers Portable - PowerShell 7</AssemblyTitle>
    <!-- The number has one owner, config\version.json, as the window's has. -->
    <VersionFile>$(MSBuildProjectDirectory)\..\..\config\version.json</VersionFile>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(VersionFile)')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <ApplicationIcon>..\..\system_core\icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
  </ItemGroup>

  <!-- A win-x64 publish puts System.Management.Automation.dll in the root of the output, and
       PowerShell looks for its built-in modules (Management, Utility, Security...) next to it, in
       Modules\. The SDK leaves them under runtimes\win\...\Modules: copied up, and the Unix ones
       dropped. ref\ stays: Add-Type compiles against it. Debug symbols go: nobody running the
       program needs them. -->
  <Target Name="ArrangePublish" AfterTargets="Publish">
    <ItemGroup>
      <PackagePdb Include="$(PublishDir)*.pdb" />
      <PsModule Include="$(PublishDir)runtimes\win\lib\net10.0\Modules\**\*" />
    </ItemGroup>
    <Delete Files="@(PackagePdb)" />
    <Copy SourceFiles="@(PsModule)" DestinationFiles="@(PsModule->'$(PublishDir)Modules\%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(PublishDir)runtimes\unix" />
  </Target>
</Project>
